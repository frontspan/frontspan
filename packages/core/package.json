{
  "name": "@frontspan/core",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "node": {
        "types": "./dist/load-config.d.ts",
        "import": "./dist/load-config.js"
      }
    },
    "./schemas/*.schema.json": "./dist/schemas/*.schema.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc"
  }
}
