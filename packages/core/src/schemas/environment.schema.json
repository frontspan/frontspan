{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontspan environment overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name"],
  "properties": {
    "$schema": { "$ref": "#/$defs/text" },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "resources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(?:constructor|prototype)$)[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "upstream": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "baseUrl": { "$ref": "#/$defs/urlRef" } }
          },
          "defaults": { "$ref": "#/$defs/operationalPolicies" }
        }
      }
    },
    "endpoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,62}\\.[a-z][a-z0-9-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "policies": { "$ref": "#/$defs/operationalPolicies" } }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "urlRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "const": "env" },
            "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
          }
        }
      ]
    },
    "operationalPolicies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "validation": { "enum": ["strict", "warn", "off"] },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
