{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontspan HTTP resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "kind", "contract", "upstream"],
  "properties": {
    "$schema": { "$ref": "#/$defs/text" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "kind": { "const": "http" },
    "contract": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "file" },
            "path": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "url" },
            "url": { "$ref": "#/$defs/urlRef" }
          }
        }
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "$ref": "#/$defs/urlRef" },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "adapterId"],
              "properties": {
                "kind": { "const": "forward" },
                "adapterId": { "$ref": "#/$defs/text" }
              }
            }
          ]
        }
      }
    },
    "direct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": { "type": "boolean" },
        "publicBaseUrl": { "$ref": "#/$defs/urlRef" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "validation": { "enum": ["strict", "warn", "off"] },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "urlRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "literal" },
            "value": { "$ref": "#/$defs/text" }
          }
        },
        { "$ref": "#/$defs/envRef" }
      ]
    },
    "envRef": {
      "description": "Environment-variable reference. V1 secret references use this same shape in server-only credential fields.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "env" },
        "name": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" }
      }
    }
  }
}
