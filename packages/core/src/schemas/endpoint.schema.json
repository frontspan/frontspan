{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frontspan endpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "resourceId",
    "source",
    "domain",
    "name",
    "execution",
    "response"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}\\.[a-z][a-z0-9-]{0,62}$"
    },
    "resourceId": { "$ref": "#/$defs/slug" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "$ref": "#/$defs/httpMethod" },
        "path": { "$ref": "#/$defs/httpPath" }
      }
    },
    "domain": { "$ref": "#/$defs/slug" },
    "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "direct" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "method", "path"],
          "properties": {
            "mode": { "const": "proxy" },
            "method": { "$ref": "#/$defs/httpMethod" },
            "path": { "$ref": "#/$defs/httpPath" }
          }
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "data" },
            "mapping": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "data": { "$ref": "#/$defs/jsonPointer" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mapping"],
          "properties": {
            "kind": { "const": "paginated" },
            "mapping": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items", "page", "pageSize", "totalCount"],
              "properties": {
                "items": { "$ref": "#/$defs/jsonPointer" },
                "page": { "$ref": "#/$defs/jsonPointer" },
                "pageSize": { "$ref": "#/$defs/jsonPointer" },
                "totalCount": { "$ref": "#/$defs/jsonPointer" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "empty" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "binary" } }
        }
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "enum": ["query", "mutation", "none"] } }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "validation": { "enum": ["strict", "warn", "off"] },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "httpMethod": {
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "httpPath": { "type": "string", "pattern": "^/" },
    "jsonPointer": { "type": "string", "pattern": "^(?:/(?:[^~/]|~[01])*)*$" }
  }
}
